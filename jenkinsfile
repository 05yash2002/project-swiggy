pipeline {
    agent any
    tools {
        jdk 'jdk21'
    }
    environment {
        SCANNER_HOME = tool 'SonarQubeScanner'
    }
    stages {
        stage('clean workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout from Git') {
            steps {
                git url: 'https://github.com/05yash2002/project-swiggy.git', branch: 'main'
            }
        }
        stage("Sonarqube Analysis") {
            steps {
                withSonarQubeEnv('sonar-server') { 
                    sh ''' 
                    $SCANNER_HOME/bin/sonar-scanner \
                        -Dsonar.projectName=Swiggy \
                        -Dsonar.projectKey=Swiggy 
                    '''
                }
            }
        }
        stage("quality gate") {
           steps {
               script {
                   timeout(time: 2, unit: 'MINUTES') {
                       waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token' 
                   }
               }
           } 
        }
        stage('Install Dependencies') {
            steps {
                sh "npm install"
            }
        }
        stage('TRIVY FS SCAN') {
            steps {
                sh "trivy fs . > trivyfs.txt"
            }
        }
        stage("Docker Build & Push") {
            steps {
                script {
                   withDockerRegistry(credentialsId: 'docker-hub-credentials', toolName: 'docker') {    
                       sh "docker build -t swiggy ."
                       sh "docker tag swiggy yashowardhan777/swiggy:latest"
                       sh "docker push yashowardhan777/swiggy:latest"
                    }
                }
            }
        }
        stage("TRIVY") {
            steps {
                sh "trivy image yashowardhan777/swiggy:latest > trivy.txt" 
            }
        }
        stage('Deploy to container') {
            steps {
                sh '''
                docker rm -f swiggy || true
                docker run -d --name swiggy -p 3000:3000 yashowardhan777/swiggy:latest
                '''
            }
        }
    }
}
