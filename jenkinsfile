pipeline{
    agent any
    tools{
        jdk 'jdk21'
        nodejs 'node23'
    }
    environment {
        SCANNER_HOME=tool 'sonar-scanner'
    }
    stages {
        stage('clean workspace'){
            steps{
                cleanWs()
            }
        }
        stage('Checkout from Git'){
            steps{
                git 'https://github.com/KastroVKiran/DevOps-Project-Swiggy.git'
            }
        }
        stage("Sonarqube Analysis "){
            steps{
                withSonarQubeEnv('sonar-server') {
                    sh ''' 
                    $SCANNER_HOME/bin/sonar-scanner \
                        -Dsonar.projectName=Swiggy \
                        -Dsonar.projectKey=Swiggy 
                    '''
                }
            }
        }
        stage("quality gate"){
           steps {
               script {
                   // Added a timeout so the build won't hang forever if the webhook isn't configured
                   timeout(time: 2, unit: 'MINUTES') {
                       waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token' 
                   }
               }
           } 
        }
        stage('Install Dependencies') {
            steps {
                sh "npm install"
            }
        }
        stage('TRIVY FS SCAN') {
            steps {
                sh "trivy fs . > trivyfs.txt"
            }
        }
        stage("Docker Build & Push"){
            steps{
                script{
                   withDockerRegistry(credentialsId: 'docker-creds', toolName: 'docker'){    
                       sh "docker build -t swiggy ."
                       sh "docker tag swiggy yashowardhan777/swiggy:latest "
                       sh "docker push yashowardhan777/swiggy:latest "
                   }
                }
            }
        }
        stage("TRIVY"){
            steps{
                sh "trivy image yashowardhan777/swiggy:latest > trivy.txt" 
            }
        }
        stage('Deploy to container'){
            steps{
                sh '''
                docker rm -f swiggy || true
                docker run -d --name swiggy -p 3000:3000 yashowardhan777/swiggy:latest
                '''
            }
        }
    }
}
